# Copy to web/.env.local (git-ignored). Vite only exposes vars prefixed with VITE_.

# Optional: Skærmkort basemap and address search (Adressevælgeren). A plain
# Datafordeler API-Key for *Tangkortet's own* IT-system -- never Svampekortet's.
# Without it the map falls back to OpenStreetMap and address search is off.
VITE_DATAFORDELER_API_KEY=

# Optional: Sentry error monitoring. Left blank, the SDK is a no-op.
VITE_SENTRY_DSN=
